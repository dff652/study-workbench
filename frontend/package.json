{
  "name": "study-workbench-frontend",
  "private": true,
  "version": "0.2.0-dev",
  "type": "module",
  "scripts": {
    "build": "npm run design:check && tsc --noEmit -p tsconfig.json && vite build",
    "test": "npm run design:test && vitest run",
    "design:lint": "designmd lint ../DESIGN.md --format json",
    "design:check": "node scripts/design-system.mjs check",
    "design:generate": "node scripts/design-system.mjs generate",
    "design:test": "node --test scripts/design-system.checks.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.8.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "26.1.0",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.3",
    "vite": "8.0.8",
    "vitest": "4.1.4",
    "yaml": "2.8.1"
  }
}
