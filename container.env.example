# Copy to a private, ignored file such as .env.container.local before use.
# Keep generated passwords and keys on this machine; do not commit that file.
SWB_IMAGE_TAG=local
SWB_RESOURCE_OWNER=manual
SWB_SOURCE_REVISION=working-tree
SWB_BIND_ADDRESS=127.0.0.1
SWB_HOST_PORT=8000

SWB_DB_NAME=study_workbench
SWB_DB_USER=study_workbench
SWB_DB_PASSWORD=
SWB_SECRET_KEY=
SWB_ALLOWED_HOSTS=127.0.0.1,localhost
SWB_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Keep false for the default loopback HTTP acceptance path.
# Set true only when a trusted local reverse proxy provides HTTPS and overwrites
# X-Forwarded-Proto before forwarding to the loopback-bound app.
SWB_SECURE_SSL_REDIRECT=false
SWB_SECURE_COOKIES=false
SWB_TRUST_PROXY_HEADERS=false

# Empty by default. Set locally only when manually authorizing model tests.
# Model name, URL, budget and data scope are versioned in the authenticated UI.
SWB_MODEL_API_KEY=
SWB_MODEL_ALLOWED_HOSTS=
