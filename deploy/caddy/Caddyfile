{
    admin off
    auto_https disable_redirects
    skip_install_trust
}

https://{$SWB_TLS_HOST}:8443 {
    tls internal
    reverse_proxy web:8000 {
        # This listener is HTTPS-only. Never trust a caller's protocol header.
        header_up X-Forwarded-Proto https
        header_up -Forwarded
    }
}
