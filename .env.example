# Explicit database configuration for a separately provisioned development DB.
# manage.py does not automatically load this file.
SWB_DB_HOST=/path/to/private/postgresql/socket
SWB_DB_NAME=study_workbench_dev
SWB_DB_USER=study_workbench_dev
SWB_DB_PASSWORD=
SWB_SECRET_KEY=replace-with-a-local-secret
SWB_DATA_ROOT=/path/to/private/study-workbench-data
SWB_ALLOWED_HOSTS=127.0.0.1,localhost
